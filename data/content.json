      "FAQ": {
        "variants": {
          "EmboriaFAQ1": {
            "tagline": "FAQS",
            "taglineDividers": true,
            "headingPart1": "Frequently Asked",
            "headingHighlight": "Questions",
            "description": "Find answers to the most common questions about our visa, immigration and consultancy services.",
            "image": {
              "src": "/faq.webp",
              "alt": "Passport on world map with miniature airplane and travel photographs"
            },
            "items": [
              {
                "id": "1",
                "question": "What types of visa services do you offer?",
                "answer": "We provide a wide range of visa services including Tourist Visa, Student Visa, Work Visa, Business Visa and Immigration support for various countries."
              },
              {
                "id": "2",
                "question": "How long does the visa process take?",
                "answer": "Processing times vary depending on the destination country and visa category, typically ranging from a few days to several weeks. We provide exact timelines during your initial consultation."
              },
              {
                "id": "3",
                "question": "What documents are required for a visa application?",
                "answer": "Basic documents include a valid passport, photographs, financial statements, travel itinerary, and relevant sponsorship or invitation letters. Our team provides a tailored checklist for your specific visa type."
              },
              {
                "id": "4",
                "question": "Do you provide immigration and PR services?",
                "answer": "Yes, we offer end-to-end assistance for Permanent Residency (PR), skilled migration, family sponsorship, and long-term settlement programs across top global destinations."
              },
              {
                "id": "5",
                "question": "Can you help with visa rejections or re-application?",
                "answer": "Absolutely. We analyze refusal letters, identify underlying gaps, strengthen supporting documentation, and prepare compelling re-applications or appeals to maximize approval chances."
              }
            ]
          }
        }
